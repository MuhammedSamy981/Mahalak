  public async Task<bool> VerifyFieldAsync(string value, string type)
  {
    List<User> users = await  unitOfWork.UsersRepository.GetAllAsync();
    for (int index = 0; index < users.Count; ++index)
    {
      if (type == "Name" && users[index].Name == value.Trim()
      || type == "Email" && users[index].Email == value.Trim()
      || type == "Phone" && users[index].Phone == value.Trim())
        return false;
    }
    return true;
  }

  public async Task<bool> VerifyEditFieldAsync(string value, string type, Guid? id)
  {
    List<User> users = await  unitOfWork.UsersRepository.GetAllAsync();
    var user = await  unitOfWork.UsersRepository.GetByIdAsync(id);
    if (user != null)
    {
      for (int index = 0; index < users.Count; ++index)
      {
        if (type == "Name" && user.Name != value && users[index].Name == value.Trim() || type == "Email" && user.Email != value && users[index].Email == value.Trim() || type == "Phone" && user.Phone != value && users[index].Phone == value.Trim())
          return false;
      }
    }
    return true;
  }

