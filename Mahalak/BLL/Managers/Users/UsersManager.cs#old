  public async Task<GetUserLoginDTO?> GetLoginAsync(string emailOrPhoneNumber, string Password)
  {
    var user = await  unitOfWork.UsersRepository.GetLoginAsync(emailOrPhoneNumber.Trim(), Password);
    if (user == null)
      return null;
    user.LoginTime = DateTime.Now.ToString("dddd, dd MMMM yyyy h:mm tt");
     unitOfWork.UsersRepository.Update(user);
     unitOfWork.SaveChanges();
    Claim claim1 = new Claim(ClaimTypes.Name, user.Name);
    Claim claim2 = new Claim(ClaimTypes.Email, user.Email);
    Claim claim3 = new Claim(ClaimTypes.MobilePhone, user.Phone);
    Claim claim4 = new Claim(ClaimTypes.Role, user.Role);
    ClaimsIdentity identity = new ClaimsIdentity(CookieAuthenticationDefaults.AuthenticationScheme);
    identity.AddClaim(claim1);
    identity.AddClaim(claim2);
    identity.AddClaim(claim3);
    identity.AddClaim(claim4);
    ClaimsPrincipal claimsPrincipal = new ClaimsPrincipal();
    claimsPrincipal.AddIdentity(identity);
    return new GetUserLoginDTO()
    {
      Email = user.Email,
      Status = user.Status,
      ViolationsCount = user.ViolationsCount,
      ExpDtOfBan = user.ExpDtOfBan,
      CP = claimsPrincipal
    };
  }

  public async Task<bool> AddAsync(AddUserDTO userDTO)
