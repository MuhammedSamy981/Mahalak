    foreach (User user in await  unitOfWork.UsersRepository.GetAllAsync())
    {
      if (user.AddedShopsExpDate != string.Empty && Convert.ToDateTime(user.AddedShopsExpDate) <= DateTime.Now)
        await  EditAddingShopsAsync(user.ID, 2, 0);
    }
    return true;
  }

