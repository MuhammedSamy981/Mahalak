  public async Task<bool> ResetPasswordAsync(
    GetForgottenUserPasswordDTO forgottenUserPasswordDTO)
  {
    var user = await  unitOfWork.UsersRepository.GetByEmailAsync(forgottenUserPasswordDTO.Email);
    if (user == null)
      return false;
    Message message = new Message()
    {
      RecipientName = user.Name,
      RecipientEmail = user.Email,
      Subject = "أسترجاع كلمة المرور",
      Body = "كلمة المرور الخاصة بك هى : " + user.Password
    };
    if (!await  unitOfWork.APIMailService.SendAsync(message))
    {
      int num = await  unitOfWork.MailService.SendAsync(message) ? 1 : 0;
    }
    return true;
  }

  public async Task<bool> CheckViolationsCountAsync()
  {
    foreach (User user in await  unitOfWork.UsersRepository.GetAllAsync())
    {
      if (user.ExpDtOfBan != string.Empty)
      {
        if (Convert.ToDateTime(user.ExpDtOfBan) <= DateTime.Now)
          await  EditStatusAsync(user.ID, "مفعل");
        else
          await  EditStatusAsync(user.ID, "محظور");
      }
    }
    return true;
  }

  public async Task EditAddingShopsAsync(Guid id, int shopsCount, int period)
  {
    var user = await unitOfWork.UsersRepository.GetByIdAsync(id);
    if (user == null)
      return;
    user.MaxShopNum = shopsCount;
    user.AddedShopsExpDate = period == 0 ? string.Empty : DateTime.Now.AddMonths(period).ToString("dddd, dd MMMM yyyy h:mm tt");
     unitOfWork.UsersRepository.Update(user);
    int num = await  unitOfWork.SaveChangesAsync();
  }

  public async Task<bool> CheckAddingShopsPeriodAsync()
