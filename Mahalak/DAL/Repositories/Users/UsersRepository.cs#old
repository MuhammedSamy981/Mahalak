using Microsoft.EntityFrameworkCore;

namespace Mahalak;
public class UsersRepository : GenericRepository<User>,IUsersRepository
{
  private readonly MahalakDbContext mahalakDbContext;

  public UsersRepository(MahalakDbContext mahalakDbContext)
    : base(mahalakDbContext)
  {
     this.mahalakDbContext = mahalakDbContext;
  }

  public async Task<List<User>> GetAllByRoleAsync(string role)
  {
    return await mahalakDbContext.Set<User>().Where(r => r.Role == role)
    .OrderByDescending(u => u.Id).ToListAsync();
  }
  public async Task<List<User>> GetAllByEmailOrPhoneAsync(string emailOrPhoneNumber, string role)
  {
    return await mahalakDbContext.Set<User>().Where(u => u.Role == role
    && (u.Email.Contains(emailOrPhoneNumber) || u.Phone.Contains(emailOrPhoneNumber))).ToListAsync();
  }

  public User? GetByName(string name)
  {
    return  mahalakDbContext.Set<User>().FirstOrDefault(u => u.Name == name);
  }

  public async Task<User?> GetByNameAsync(string name)
  {
    return await  mahalakDbContext.Set<User>().FirstOrDefaultAsync(u => u.Name == name);
  }

  public async Task<User?> GetLoginAsync(string emailOrPhoneNumber, string Password)
  {
    return await  mahalakDbContext.Set<User>()
    .FirstOrDefaultAsync(u => (u.Email == emailOrPhoneNumber || u.Phone == emailOrPhoneNumber) && u.Password == Password);
  }

  public async Task<User?> GetForgottenPasswordAsync(string emailOrPhoneNumber)
  {
    return await  mahalakDbContext.Set<User>().FirstOrDefaultAsync(u => u.Email == emailOrPhoneNumber || u.Phone == emailOrPhoneNumber);
  }

  public async Task<User?> GetByEmailAsync(string Email)
  {
    return await  mahalakDbContext.Set<User>().FirstOrDefaultAsync(u => u.Email == Email);
  }

  public async Task<User?> GetByIdAsync(Guid? id)
  {
    return await  mahalakDbContext.Set<User>().Include(u => u.Shops).FirstOrDefaultAsync(u => u.Id == id);
  }

  public void DeleteById(Guid id)
  {
    User entity =  mahalakDbContext.Set<User>().Find(id)!;
    if (entity == null)
      return;
     mahalakDbContext.Set<User>().Remove(entity);
  }
}