using mailslurp.Api;
using mailslurp.Client;
using mailslurp.Model;
using Microsoft.Extensions.Options;

namespace Mahalak;

public class APIMailService : IAPIMailService
{
  private readonly MailSettings mailSettings;

  public APIMailService(IOptions<MailSettings> mailSettingsOptions)
  {
    this.mailSettings = mailSettingsOptions.Value;
  }

  public async Task<bool> SendAsync(Message message)
  {
    try
    {
       string filePath =Directory.GetCurrentDirectory() + "\\wwwroot\\templates\\mail.html";
       string emailTemplateText = await File.ReadAllTextAsync(filePath);
      string htmlBody = string.Format(emailTemplateText,message.RecipientName,message.Body,DateTime.Today.Date.ToShortDateString());
      InboxControllerApi inboxControllerApi = new InboxControllerApi(new Configuration
      {
        ApiKey = {
          {
            "x-api-key",
            this.mailSettings.ApiKey
          }
        }
      });
      InboxDto inboxWithDefaults = inboxControllerApi.CreateInboxWithDefaults(0);
      if (inboxWithDefaults.EmailAddress.Contains("@mailslurp"))
      {
        await inboxControllerApi.SendEmailAsync(inboxWithDefaults.Id,
         new SendEmailOptions(
            to: [message.RecipientEmail],
            from:$"{mailSettings.SenderName} <{inboxWithDefaults.EmailAddress}>",
            subject: message.Subject,
            body: htmlBody,
            isHTML: true
        ));
      }
      return true;
    }
    catch
    {
      return false;
    }
  }
}







