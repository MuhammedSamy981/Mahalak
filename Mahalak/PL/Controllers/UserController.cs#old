  [HttpPost]
  public async Task<IActionResult> Register(AddUserDTO userDTO)
  {
    if (ModelState.IsValid)
    {
      clickCount++;
      if (clickCount == 1)
      {
        bool result = await usersManager.AddAsync(userDTO);
        if (!result)
        {
          return View();
        }
        await usersManager.SendVerificationLinkAsync(userDTO.Email);

      }
      clickCount = 0;
      return RedirectToAction("ViewForCustumers", "Shop");
    }
    return View();
  }

