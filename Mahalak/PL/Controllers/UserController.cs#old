    var user = await usersManager.GetByIdAsync(id);
    if (user == null)
    {
      return NotFound();
    }
    return View(new UpdateUserDTO
    {
      Name = user.Name,
      Password = user.Password,
      Gender = user.Gender,
      Phone = user.Phone,
      Birthdate = user.Birthdate,
      Email = user.Email
    });
  }


  [HttpPost]
  public async Task<IActionResult> Edit(UpdateUserDTO userDTO)
  {
    if (ModelState.IsValid)
    {
      userDTO.ID = await usersManager.GetIdByNameAsync(User.Identity?.Name!);
      if (userDTO.ID == null)
      {
        return BadRequest();
      }
      Console.WriteLine("\n" + userDTO.ID + "\n");
      bool result = await usersManager.UpdateAsync(userDTO);
      if (!result)
      {
        return View(userDTO);
      }
      await usersManager.SendVerificationLinkAsync(userDTO.Email);
      await HttpContext.SignOutAsync();
      return RedirectToAction("ViewForCustumers", "Shop");

    }
    return View();
  }

