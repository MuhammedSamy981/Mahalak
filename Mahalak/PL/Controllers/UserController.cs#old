  [Authorize(Roles = "Manager,Admin")]
  [HttpGet]
  [Route("admin")]
  [Route("admin/{table}/{id}")]
  public async Task<IActionResult> Index(string table, int id)
  {
    if (id == 0)
    {
      id = 1;
    }
    
    ViewBag.admins = await usersManager
    .GetAllPaginatedByRoleAsync("Admin", adminsPageSize, 1);
    ViewBag.AdminsCount = (ViewBag.admins.Count != 0) ? ViewBag.admins[0].UsersCount : 0;
    ViewBag.AdminsPageSize=adminsPageSize;
   
    ViewBag.users = await usersManager
    .GetAllPaginatedByRoleAsync("User", usersPageSize, 1);
    ViewBag.UsersCount = (ViewBag.users.Count != 0) ? ViewBag.users[0].UsersCount : 0;
    ViewBag.UsersPageSize=usersPageSize;
   
    ViewBag.shops = await shopsManager.GetAllPaginatedAsync(shopsPageSize, 1);
    ViewBag.ShopsCount = (ViewBag.shops.Count != 0) ? ViewBag.shops[0].ShopsCount : 0;
    ViewBag.ShopsPageSize=shopsPageSize;

    ViewBag.products = await productsManager.GetAllPaginatedAsync(productsPageSize, 1);
    ViewBag.ProductsCount = (ViewBag.products.Count != 0) ? ViewBag.products[0].ProductsCount : 0;
    ViewBag.ProductsPageSize=productsPageSize;

    if (table == null ||table=="")
    {
       HttpContext.Session.SetString("SearchForAdmins", "");
      HttpContext.Session.SetString("SearchForUsers", "");
      HttpContext.Session.SetString("SearchForProducts", "");
      HttpContext.Session.SetString("SearchForShops", "");
    }

    if (table == "admins")
    {
      HttpContext.Session.SetString("SearchForUsers", "");
      HttpContext.Session.SetString("SearchForProducts", "");
      HttpContext.Session.SetString("SearchForShops", "");

await GetSearchForAdminsResult(id);
    }

    if (table == "users")
    {
      HttpContext.Session.SetString("SearchForAdmins", "");
      HttpContext.Session.SetString("SearchForProducts", "");
      HttpContext.Session.SetString("SearchForShops", "");

      await GetSearchForUsersResult(id);
    }



    if (table == "shops")
    {
            HttpContext.Session.SetString("SearchForAdmins", "");
      HttpContext.Session.SetString("SearchForProducts", "");
      HttpContext.Session.SetString("SearchForUsers", "");

await GetSearchForShopsResult(id);
    }



    if (table == "products")
    {
            HttpContext.Session.SetString("SearchForAdmins", "");
      HttpContext.Session.SetString("SearchForShops", "");
      HttpContext.Session.SetString("SearchForUsers", "");
      
      await GetSearchForProductsResult(id);
    }


    ViewBag.ratings = await ratingsManager.GetAllWithCommentsInWaiting();

    ViewBag.sCategories = new SelectList(await sCategoriesManager.GetAllAsync(), "ID", "Name", 0);
    ViewBag.countries = new SelectList(await countriesManager.GetAllAsync(), "ID", "Name", 0);
    ViewBag.cities = new SelectList(await citiesManager.GetAllAsync(), "ID", "Name", 0);
    ViewBag.areas = new SelectList(await areasManager.GetAllAsync(), "ID", "Name", 0);
    ViewBag.pCategories = new SelectList(await pCategoriesManager.GetAllAsync(), "ID", "Name", 0);
    ViewBag.conditions = new SelectList(await conditionsManager.GetAllAsync(), "ID", "Name", 0);
    return View();
  }

