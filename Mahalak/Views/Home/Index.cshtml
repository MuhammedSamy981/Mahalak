@addTagHelper *,Mahalak
@{
    ViewData["Title"] = "الصفحة الرئيسية";
}

<main>

  <div class="position-relative overflow-hidden text-center bg-dark opacity-75 mt-4">
    <div class="col-md-6 p-5 mx-auto my-5">
      <h1 class="display-3 fw-bold text-light">تسوق و قم بأنشاء المحل الخاص بك مع محلك</h1>
      <h3 class="fw-normal text-muted mb-3">يوجد لدينا العديد من المحلات مثل محل أجهزة كهربائية و محل موبيلات و محل ملابس و محل شنط و أحذية .... إلخ</h3>
      <div class="d-flex gap-3 justify-content-center lead fw-normal">
        <a class="btn btn-light" asp-controller="shop" asp-action="Index">
          تصفح المحلات
        </a>

                <a class="btn btn-light" asp-controller="product" asp-action="Index">
          تصفح المنتجات
        </a>
      </div>
    </div>
    <div class="product-device shadow-sm d-none d-md-block"></div>
    <div class="product-device product-device-2 shadow-sm d-none d-md-block"></div>
  </div>

  <section class="intro-content mt-5">
  
      <div class="text-center container opacity-75">
        <h2 class="fw-bold text-dark">ليه تستخدم موقع محلك</h2>
        <p class="text-dark">موقع محلك بيسمح ليك بالتسوق و أنشاء محل خاص بيك تعرض عليه منتجاتك الخاصة بيك من بيتك</p>
      </div>

      <div class="row">

        <div class="col-md-4 d-flex align-items-stretch justify-content-center mb-5 mb-lg-0">
          <div class="card border-secondary border-0 shadow mb-3 opacity-75" style="max-width: 18rem;">
            <div class="card-body">
            <!--  <img src="assets/affordable.png" alt="Affordable" width="50" height="50"> -->
              <h5 class="card-title">توفير</h5>
              <p class="card-text">حتوفر وقت و مجهود سواء كنت بائع أو مشتري.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4 d-flex align-items-stretch justify-content-center mb-5 mb-lg-0">
          <div class="card border-secondary shadow  border-0 mb-3 opacity-75" style="max-width: 18rem;">
            <div class="card-body">
              <!--  <img src="assets/eco-friendly.png" alt="Eco-Friendly" width="50" height="50">-->
              <h5 class="card-title">تكلفة</h5>
              <p class="card-text">مع محلك مفيش تكلفة إيجار محل و لا دفع فواتير الكهربا أو غيرها من الفواتير.</p>
            </div>
          </div>
        </div>

        <div class="col-md-4 d-flex align-items-stretch justify-content-center mb-5 mb-lg-0">
          <div class="card border-secondary shadow border-0 mb-3 opacity-75" style="max-width: 18rem;">
            <div class="card-body">
              <!--  <img src="assets/wide-variety.png" alt="Wide Variety" width="50" height="50">-->
              <h5 class="card-title">سهولة الوصول</h5>
              <p class="card-text">لو أنت بائع تقدر توصل بسهولة لعملائك و تبيع منتجاتك بأسم مميز لمحلك و لو أنت مشتري تقدر توصل بسهولة للمحل اللى متعود تشتري من عنده منتجاتك .</p>
            </div>
          </div>
        </div>

      </div>

 

  </section>


    <!-- How It Works Section -->
    <section class="py-5 bg-dark opacity-75">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="fw-bold">أزاي أستخدم موقع محلك</h2>
            </div>
            <div class="row">
                <div class="col-md-4">
                    <div class="how-it-works-step position-relative pb-5">
                        <div class="step-number position-absolute bottom-100 end-0 d-flex align-items-center justify-content-center fs-5 fw-bold">1</div>
                        <h4>تصفح المحلات</h4>
                        <p>تصفح العديد من المحلات بالقرب منك داخل محافظتك</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="how-it-works-step position-relative pb-5">
                        <div class="step-number position-absolute bottom-100 end-0 d-flex align-items-center justify-content-center fs-5 fw-bold">2</div>
                        <h4>أنشئ محل</h4>
                        <p>قم بأنشاء المحل الخاص بك وأعرض عليه منتجاتك.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="how-it-works-step position-relative">
                        <div class="step-number position-absolute bottom-100 end-0 d-flex align-items-center justify-content-center fs-5 fw-bold">3</div>
                        <h4>تواصل مع البائع أو المشتري</h4>
                        <p> لو أنت بائع تواصل مع عملائك عن طريق وضع رقم الهاتف او الواتس أب لسهولةالوصول إليك و لو أنت مشتري تواصل مع صاحب المحل عن طريق رقم الهاتف اوالواتس اب الخاص بصاحب المحل</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

  <!-- Testimonials -->
  <!--<section class="testimonial text-center">
