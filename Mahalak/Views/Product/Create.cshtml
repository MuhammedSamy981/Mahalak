@{
  ViewData["Title"] = "أضافة المنتج";
}

@model ProductAddViewModel
<form id="myForm" name="Form1" enctype="multipart/form-data" class="container col-lg-6 bg-dark opacity-75"
  method="post">
@Html.AntiForgeryToken()

  <div class="container g-3 align-items-center mb-3">
    <legend class="my-4">أضافة منتج</legend>
  </div>

  <div class="container g-3 align-items-center mb-3">
    <input class="form-control " asp-for="Name" placeholder="أسم المنتج">
    <span class="form-text text-danger" asp-validation-for="Name"></span>
  </div>

  <div class="container g-3 align-items-center mb-3">
    <select class="form-select" asp-for="CategoryId" asp-items="ViewBag.categories">
      <option value="0" selected>- أختر نوع المنتج -</option>
    </select>
    <span class="form-text text-danger" asp-validation-for="CategoryId"></span>
  </div>


  <div class="container g-3 align-items-center mb-3">
    <input class="form-control " asp-for="Price" placeholder="سعر المنتج">
    <span class="form-text text-danger" asp-validation-for="Price"></span>
  </div>

  <div class="container g-3 align-items-center mb-3">
    <select class="form-select" asp-for="ConditionId" asp-items="ViewBag.conditions">
      <option value="0" selected>- أختر حالة المنتج -</option>
    </select>
    <span class="form-text text-danger" asp-validation-for="ConditionId"></span>
  </div>


  <div class="container g-3 align-items-center mb-3">
    <div class="col-8 mb-3">
      <label href="#" class="btn btn-danger mb-1">
        <input id="images" asp-for="Images" multiple  accept="image/*" style="display: none" />
        <span> أضافة صور المنتج</span>
      </label>
      <div id="product_images"></div>
    </div> 
          
      <span class="form-text text-danger" asp-validation-for="Images"></span>
  </div>


  <div class="container g-3 align-items-center mb-3">
    <textarea class="form-control" asp-for="Describtion" placeholder="وصف المنتج">
    </textarea>
    <span class="form-text text-danger" asp-validation-for="Describtion"></span>
  </div>

  <div class="container g-3 align-items-center mb-3">
    <button id="submitBtn" class="col-lg-3 btn btn-success my-4" type="submit">
      <span id="spinnerLoading" class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
      <span>أضافة</span>
    </button>
    <span> <a class="btn btn-danger" asp-controller="product" asp-action="management" asp-route-id="@ViewBag.BackToShop">إلغاء</a></span>
  </div>


</form>



<script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/product/create.js" asp-append-version="true"></script>