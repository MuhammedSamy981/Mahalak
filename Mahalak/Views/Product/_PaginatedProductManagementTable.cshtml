  @addTagHelper *,Mahalak
  <div id="productManagementTable">
  </div>

@if(ViewBag.ProductsCount!=0 && ViewBag.ProductsPageSize!=0)
        {
     <vc:pagination page-size="@ViewBag.ProductsPageSize" list-length="@ViewBag.ProductsCount" controller-name="product" action-name="getProductManagementTable" content-id="productManagementTable">
          </vc:pagination> 
}



    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/product/paginatedProductManagementTable.js" asp-append-version="true"></script>