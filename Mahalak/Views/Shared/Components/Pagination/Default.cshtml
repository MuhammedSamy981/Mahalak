
@model PaginationViewComponentModel
<div class="container">
  <input id="@(Model.ControllerName+@Model.ActionName)currentPage" type=hidden value=1>

<nav *ngIf="data" aria-label="Page navigation example">
  <ul class="pagination justify-content-center px-5 opacity-75">
    <li class="page-item">
        <!-- <button id="previousPageBtn" class="page-link text-light shadow-none" aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
        </button> -->
       <button class="page-link text-light shadow-none" onclick="showPreviousPage('@Model.ControllerName','@Model.ActionName','@Model.TotalPages','@Model.ContentId'); return false;"  aria-label="Previous">
        <span aria-hidden="true">&laquo;</span>
        </button>
    </li>
    @for(int i=0;i<Model.TotalPages;i++)
    {
    <li class="page-item">
      <button id="@(Model.ControllerName+@Model.ActionName+(i+1))" onclick="showPageNumber('@Model.ControllerName','@Model.ActionName','@Model.ContentId',@(i+1)); return false;" class="page-link text-light shadow-none" >@(i+1)</button>
    </li>
    }
    <li class="page-item">
      <!--  <button id="nextPageBtn" class="page-link text-light shadow-none" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </button> -->

      <button class="page-link text-light shadow-none" onclick="showNextPage('@Model.ControllerName','@Model.ActionName','@Model.TotalPages','@Model.ContentId'); return false;" aria-label="Next">
        <span aria-hidden="true">&raquo;</span>
      </button>
    </li>
  </ul>
</nav>

</div>

        <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/pagination/default.js" asp-append-version="true"></script>