@addTagHelper *,Mahalak

@{
  ViewData["Title"] = "الصفحة الرئيسية";
}

@model List<ShopViewModel>


    <div class="container">

   <div class="container col-lg-6 opacity-75 pb-2 text-center mb-2">
      <form name="Search" class=" row" method="post">
         <div class="container g-3 align-items-center mb-2">
        <select id="ddlCategories" class="form-select" name="CategoryId" asp-items="ViewBag.categories">
          <option value="0">- حدد نوع المحل -</option>
        </select>
         </div>

          <div class="container g-3 align-items-center mb-2">
          <select id="ddlCities" class="form-select" name="CityId" asp-items="ViewBag.cities">
            <option value="0">- حدد المدينة -</option>
          </select>
          </div>
 <div class="container g-3 align-items-center mb-2">
            <select id="ddlAreas" class="form-select" name="AreaId" asp-items="ViewBag.areas">
              <option value="0">- حدد المنطقة -</option>
            </select>
            </div>
                <div class="container g-3 align-items-center mb-2">
<a id="linkCancelSearch" class="link-warning link-offset-2 link-underline-opacity-25 link-underline-opacity-100-hover"
          asp-controller="shop" asp-action="cancelSearch"> إلغاء البحث</a>
</div>
      </form>
    </div>


   <section id="paginatedShopList">
  </section>
      

    </div>


    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/shop/index.js" asp-append-version="true"></script>


    


    