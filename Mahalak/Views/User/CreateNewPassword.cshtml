@{
  ViewData["Title"] = "أنشاء كلمة مرور جديدة";
}

@model UserPasswordResetViewModel

<form id="myForm" class="container col-lg-6 bg-dark opacity-75" method="post">
    <div class="container g-3 align-items-center mb-3">
    <legend class="my-4">أنشاء كلمة مرور جديدة</legend></div>
    
  <input type=hidden asp-for="Email">
    <input type=hidden asp-for="Token">

<div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="NewPassword" placeholder="كلمة المرور">
<span class="form-text text-danger" asp-validation-for="NewPassword"></span></div>

<div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="ConfirmPass" placeholder="تأكيد كلمة المرور">
<span class="form-text text-danger" asp-validation-for="ConfirmPass"></span></div>

<div class="container g-3 align-items-center mb-3">
  <button id="submitBtn" class="col-lg-3 btn btn-success my-4" type="submit" value="CreateNewPassword">
   <span id="spinnerLoading" class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
   <span>أنشاء</span>
  </button>
 <span> 
  
   </span>
</div>
</form>

<script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/user/createNewPassword.js" asp-append-version="true"></script>

