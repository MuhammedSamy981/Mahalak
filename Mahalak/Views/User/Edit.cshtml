@{
  ViewData["Title"] = "تعديل الحساب";
}

@model UserUpdateViewModel

<form id="myForm"  class="container col-lg-6 bg-dark opacity-75" method="post">
    <div class="container g-3 align-items-center mb-3">
    <legend class="my-4">تعدبل الحساب</legend></div>


    <div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="FirstName" placeholder="الأسم الأول">
<span class="form-text text-danger" asp-validation-for="FirstName"></span></div>

    <div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="LastName" placeholder="الأسم الثاني">
<span class="form-text text-danger" asp-validation-for="LastName"></span></div>

<div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="PhoneNumber" dir="rtl" placeholder="رقم الهاتف">
<span class="form-text text-danger" asp-validation-for="PhoneNumber"></span></div>

    <div class="container g-3 align-items-center mb-3">
<input class="form-control " asp-for="Email"  placeholder="البريد الألكترونى">
<span class="form-text text-danger" asp-validation-for="Email"></span></div>

<div class="container g-3 align-items-center mb-3">
  <button id="submitBtn" class="col-lg-3 btn btn-success my-4 px-lg-0" type="submit" value="Edit" >
   <span id="spinnerLoading" class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
      <span>حفظ التعديلات</span>
  </button>
 <span>  <a class="btn btn-danger" asp-controller="home" asp-action="index">إلغاء</a></span>
</div>
</form>

<script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/user/edit.js" asp-append-version="true"></script>
