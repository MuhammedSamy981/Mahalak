@{
  ViewData["Title"] = "إعادة تعين كلمة المرور";
}

@model UserPasswordForgetViewModel

  <form id="myForm" class="container col-lg-6 bg-dark opacity-75" method="post">
        <div class="container g-3 align-items-center mb-2">
            <legend class="my-4">إعادة تعين كلمة المرور</legend>
        </div>
        <div class="container g-3 align-items-center mb-2">
            <input class="form-control" asp-for="Email" placeholder="إدخل البريد الألكترونى">
        </div>
        <div class="container g-3 align-items-center mb-2">
            <button id="submitBtn" class="col-lg-3 btn btn-success" type="submit">
                   <span id="spinnerLoading" class="spinner-border spinner-border-sm" aria-hidden="true" hidden></span>
      <span>إرسال</span>
                </button>
        </div>
        <div class="form-text text-danger container g-3 align-items-center mb-3 pb-3" asp-validation-summary="All">
        </div>
    </form>

    <script type="text/javascript" src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/js/user/resetPassword.js" asp-append-version="true"></script>

    @if ((bool?) TempData["IsExternallyLoggedIn"] == true)
    {
        <script>
            window.onload = function () {
                alert("لا يمكنك إسترجاع كلمة لهذا الحساب لأنه مسجل عن طريق Google");
            };
        </script>
    }

  